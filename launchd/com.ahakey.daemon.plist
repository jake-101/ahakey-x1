<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ahakey.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <!-- EDIT: absolute path to the compiled binary in your checkout -->
        <string>/path/to/ahakey-x1/daemon/ahakey-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ahakey-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ahakey-daemon.log</string>
</dict>
</plist>
